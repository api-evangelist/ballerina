{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/ballerina/refs/heads/main/json-structure/central-api-module-structure.json",
  "name": "Module",
  "description": "A module inside a published package.",
  "type": "object",
  "properties": {
    "packageURL": {
      "type": "string"
    },
    "apiDocURL": {
      "type": "string",
      "description": "Rendered API docs URL on lib.ballerina.io."
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "readme": {
      "type": "string"
    }
  }
}