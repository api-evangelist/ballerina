            "url": "https://api.central.ballerina.io/2.0/organizations/:org/packages",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns packages belonging to a specific organization."
